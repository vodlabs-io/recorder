{
	"name": "vodlabs-recorder",
	"version": "1.0.0",
	"private": true,
	"description": "VodLabs Recorder - Electrobun app",
	"license": "PolyForm-Noncommercial-1.0.0",
	"type": "module",
	"scripts": {
		"daemon": "bun run scripts/dev-daemon.mjs",
		"start": "electrobun prepare && vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently --kill-others-on-fail \"bun run hmr\" \"bun run start\"",
		"hmr": "electrobun prepare && vite --port 5173",
		"web": "vite --config web/vite.config.ts",
		"web:build": "vite build --config web/vite.config.ts",
		"build:stable": "electrobun prepare && vite build && electrobun build --env=stable"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@hookform/resolvers": "^5.9.2",
		"@nats-io/jetstream": "^3.4.0",
		"@nats-io/kv": "^3.4.0",
		"@nats-io/nats-core": "^3.4.0",
		"@nats-io/transport-node": "^3.4.0",
		"@tanstack/react-table": "^9.3.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"lodash.debounce": "^4.0.8",
		"lucide-react": "^1.59.0",
		"react": "^19.3.1",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.90.0",
		"react-router-dom": "^7.18.4",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.3",
		"@types/lodash.debounce": "^4.0.9",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-router-dom": "^5.3.3",
		"@vitejs/plugin-react": "^6.1.2",
		"concurrently": "^10.0.6",
		"electrobun": "2.0.2",
		"shadcn": "^4.22.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.4"
	}
}
