{
	"name": "vodlabs-recorder",
	"version": "1.0.0",
	"private": true,
	"description": "VodLabs Recorder - Electrobun app",
	"license": "PolyForm-Noncommercial-1.0.0",
	"type": "module",
	"scripts": {
		"daemon": "bun run scripts/dev-daemon.mjs",
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:stable": "vite build && electrobun build --env=stable"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@hookform/resolvers": "^5.9.1",
		"@nats-io/jetstream": "^3.4.0",
		"@nats-io/kv": "^3.4.0",
		"@nats-io/nats-core": "^3.4.0",
		"@nats-io/transport-node": "^3.4.0",
		"@tanstack/react-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"electrobun": "1.18.1",
		"lodash.debounce": "^4.0.8",
		"lucide-react": "^1.47.0",
		"react": "^19.3.0",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.88.0",
		"react-router-dom": "^7.18.4",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/lodash.debounce": "^4.0.9",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-router-dom": "^5.3.3",
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "^10.0.5",
		"shadcn": "^4.21.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	},
	"patchedDependencies": {
		"electrobun@1.18.1": "patches/electrobun@1.18.1.patch"
	}
}
