+// How long one cookie query waits before giving up on its callback.
+static const guint kCookieQueryTimeoutMs = 5000;
 
+// Runs a nested main loop until `loop` is quit, bounded by a timeout so a
+// callback that never arrives cannot wedge the caller.
+static void runBoundedLoop(GMainLoop* loop) {
+    GSource* timeout = g_timeout_source_new(kCookieQueryTimeoutMs);
+    g_source_set_callback(timeout, [](gpointer data) -> gboolean {
+        g_main_loop_quit(static_cast<GMainLoop*>(data));
+        return G_SOURCE_REMOVE;
+    }, loop, nullptr);
+    g_source_attach(timeout, g_main_loop_get_context(loop));
+
+    g_main_loop_run(loop);
+
+    g_source_destroy(timeout);
+    g_source_unref(timeout);
+}
+
+// Appends the cookies visible at `uri` to `objects`.
+static void collectCookiesForURI(WebKitCookieManager* cookieManager,
+                                 const std::string& uri,
+                                 std::vector<std::string>& objects,
+                                 std::set<std::string>& seen) {
+    CookieAccumulator* acc = new CookieAccumulator();
+    acc->objects = &objects;
+    acc->seen = &seen;
+    acc->loop = g_main_loop_new(NULL, FALSE);
+    acc->done = false;
+    acc->abandoned = false;
+
+    webkit_cookie_manager_get_cookies(cookieManager, uri.c_str(), nullptr,
+                                      onGetCookiesFinished, acc);
+    runBoundedLoop(acc->loop);
+    g_main_loop_unref(acc->loop);
+
+    if (acc->done) {
+        delete acc;
+    } else {
+        // Timed out. The callback may still fire; hand it ownership and cut its
+        // reference to our stack.
+        acc->abandoned = true;
+        acc->objects = nullptr;
+        acc->seen = nullptr;
+        acc->loop = nullptr;
+    }
+}
