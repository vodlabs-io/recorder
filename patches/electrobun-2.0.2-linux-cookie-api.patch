+        WebKitWebViewImpl* impl = static_cast<WebKitWebViewImpl*>(user_data);
+        if (!impl->popupsEnabled || impl->isRemoved) {
+            return nullptr;
+        }
+        GtkWidget* child = webkit_web_view_new_with_related_view(opener);
+        webkit_web_view_set_settings(WEBKIT_WEB_VIEW(child), webkit_web_view_get_settings(opener));
+        g_signal_connect(child, "create", G_CALLBACK(onCreatePopup), impl);
