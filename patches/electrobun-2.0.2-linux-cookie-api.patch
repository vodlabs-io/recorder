+            gtk_widget_show_all(GTK_WIDGET(win));
+        }), popup);
+        g_signal_connect(child, "close", G_CALLBACK(+[](WebKitWebView*, gpointer win) {
+            gtk_widget_destroy(GTK_WIDGET(win));
