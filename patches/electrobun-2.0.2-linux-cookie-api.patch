+// Carries the domain list out of the website-data fetch, on the same joint
+// ownership terms as CookieAccumulator.
+struct CookieDomainFetch {
+    std::vector<std::string>* domains;
+    GMainLoop* loop;
+    bool done;
+    bool abandoned;
+};
+
+static void onFetchCookieDomainsFinished(GObject* source, GAsyncResult* result, gpointer user_data) {
+    CookieDomainFetch* data = static_cast<CookieDomainFetch*>(user_data);
+    GError* error = nullptr;
+    GList* items = webkit_website_data_manager_fetch_finish(
+        WEBKIT_WEBSITE_DATA_MANAGER(source), result, &error);
+
+    if (!error && !data->abandoned) {
+        for (GList* item = items; item; item = item->next) {
+            WebKitWebsiteData* entry = static_cast<WebKitWebsiteData*>(item->data);
+            const char* name = webkit_website_data_get_name(entry);
+            if (name && *name) {
+                data->domains->push_back(name);
+            }
+        }
+    }
+
+    if (items) {
+        g_list_free_full(items, (GDestroyNotify)webkit_website_data_unref);
+    }
+    if (error) {
+        g_error_free(error);
+    }
+
+    if (data->abandoned) {
+        delete data;
+        return;
+    }
+    data->done = true;
     if (data->loop) {
         g_main_loop_quit(data->loop);
     }
 }
 
+// Returns the domains the partition holds cookies for.
+static std::vector<std::string> fetchCookieDomains(WebKitWebsiteDataManager* dataManager) {
+    std::vector<std::string> domains;
+
+    CookieDomainFetch* fetch = new CookieDomainFetch();
+    fetch->domains = &domains;
+    fetch->loop = g_main_loop_new(NULL, FALSE);
+    fetch->done = false;
+    fetch->abandoned = false;
+
+    webkit_website_data_manager_fetch(dataManager, WEBKIT_WEBSITE_DATA_COOKIES, nullptr,
+                                      onFetchCookieDomainsFinished, fetch);
+    runBoundedLoop(fetch->loop);
+    g_main_loop_unref(fetch->loop);
+
+    if (fetch->done) {
+        delete fetch;
+    } else {
+        fetch->abandoned = true;
+        fetch->domains = nullptr;
+        fetch->loop = nullptr;
+    }
+
+    return domains;
+}
