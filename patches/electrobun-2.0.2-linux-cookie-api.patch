+// JSON-escape one cookie field. Cookie values routinely carry quotes and
+// backslashes; interpolated raw they produce a document the caller cannot parse,
+// and one bad cookie takes the whole jar down with it.
+static std::string jsonEscapeCookieField(const char* raw) {
+    std::string out;
+    if (!raw) {
+        return out;
+    }
+    for (const unsigned char* p = reinterpret_cast<const unsigned char*>(raw); *p; ++p) {
+        switch (*p) {
+            case '"':  out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            case '\b': out += "\\b";  break;
+            case '\f': out += "\\f";  break;
+            case '\n': out += "\\n";  break;
+            case '\r': out += "\\r";  break;
+            case '\t': out += "\\t";  break;
+            default:
+                if (*p < 0x20) {
+                    static const char* kHex = "0123456789abcdef";
+                    out += "\\u00";
+                    out += kHex[(*p >> 4) & 0xF];
+                    out += kHex[*p & 0xF];
+                } else {
+                    out += static_cast<char>(*p);
+                }
+        }
+    }
+    return out;
+}
