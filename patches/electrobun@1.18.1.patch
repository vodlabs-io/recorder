+// The events a page's own preload emits. Everything else (navigation
+// decisions, downloads) comes from native code, so a page claiming one is
+// forging it.
+const PAGE_EVENTS = new Set(["dom-ready", "did-navigate-in-page", "host-message", "new-window-open"]);
+
+// isPageEvent accepts a page-sent event only when it names the webview it came
+// from (native passes that id; the payload's is the page's own claim) and is
+// one a page may send.
+function isPageEvent(senderId: number, payload: { id?: unknown; eventName?: unknown } | undefined): boolean {
+	return !!payload && payload.id === senderId && PAGE_EVENTS.has(String(payload.eventName));
+}
