+// Bun 1.4 decodes FFIType.cstring callback arguments to JS strings; earlier
+// releases hand over pointers. Accept both (as electrobun 2.x's
+// ffiCStringToString does).
+export function ffiCStringToString(value: string | Pointer | number | null): string {
+	if (typeof value === "string") return value;
+	return value ? new CString(value as Pointer).toString() : "";
+}
+
+// Bun 1.4 terminates the Worker, or crashes the process, when a threadsafe
+// JSCallback throws. The Worker is the whole app, so nothing may escape one:
+// app listeners run inside these, and a throw is logged instead.
+function guardedJSCallback(
+	label: string,
+	fn: (...args: any[]) => void,
+	options: ConstructorParameters<typeof JSCallback>[1],
+): JSCallback {
+	return new JSCallback((...args: any[]) => {
+		try {
+			fn(...args);
+		} catch (err) {
+			console.error(`[electrobun] ${label} callback threw:`, err);
+		}
+	}, options);
+}
