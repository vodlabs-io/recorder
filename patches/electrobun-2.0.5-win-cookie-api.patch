+// onUIThread runs fn on the thread that owns the WebView2 objects.
+//
+// Every ICoreWebView2 interface is apartment-threaded and belongs to the thread
+// that created the environment - the one running the message loop in
+// startEventLoop. These exported functions are called over FFI from the app's
+// bun Worker, a different thread, so touching a cookie manager from here is a
+// cross-apartment call on a raw pointer: it does not marshal, and the completion
+// handlers it schedules are delivered to the UI thread's queue, which the caller
+// is not draining. Every other webview API in this file already hops across with
+// MainThreadDispatcher; the cookie API did not, which is why it returned nothing
+// at all.
+template <typename Func>
+static auto onUIThread(Func&& fn) -> decltype(fn()) {
+    if (GetCurrentThreadId() == g_mainThreadId) {
+        return fn();
+    }
+    return MainThreadDispatcher::dispatch_sync(std::forward<Func>(fn));
+}
+
+// awaitCompletion blocks the UI thread for one async WebView2 completion without
+// stalling it. WebView2 delivers completion handlers through this thread's
+// message queue, so a plain WaitForSingleObject would be waiting on a callback it
+// is itself preventing from arriving. Returns false on timeout.
+static bool awaitCompletion(HANDLE completed, DWORD timeoutMs) {
+    const ULONGLONG deadline = GetTickCount64() + timeoutMs;
+    for (;;) {
+        const ULONGLONG now = GetTickCount64();
+        if (now >= deadline) return false;
+        DWORD remaining = static_cast<DWORD>(deadline - now);
+        DWORD signalled = 0;
+        HRESULT hr = CoWaitForMultipleHandles(
+            COWAIT_DISPATCH_CALLS | COWAIT_DISPATCH_WINDOW_MESSAGES,
+            remaining, 1, &completed, &signalled);
+        if (hr == S_OK) return true;
+        if (FAILED(hr)) return false; // RPC_S_CALLPENDING on timeout
+    }
+}
