+// State shared between a session call and its completion handler. The handler
+// captures it by value, so a callback that arrives after the wait timed out
+// writes to memory that is still alive and signals a handle that is still open,
+// instead of scribbling over the caller's stack.
+struct SessionCallState {
+    HANDLE completed = NULL;
+    std::string json = "[]";
+    bool found = false;
+
+    SessionCallState() { completed = CreateEvent(NULL, FALSE, FALSE, NULL); }
+    ~SessionCallState() { if (completed) CloseHandle(completed); }
+    SessionCallState(const SessionCallState&) = delete;
+    SessionCallState& operator=(const SessionCallState&) = delete;
+};
