+// cookieManagerFor resolves the cookie manager of the webview belonging to
+// partitionIdentifier.
+//
+// Each partition is its own WebView2 environment with its own jar, so the old
+// "use whichever view is first in the map" would happily read another
+// partition's cookies - or, far more often, a view that has none. Must be called
+// on the UI thread.
+static ComPtr<ICoreWebView2CookieManager> cookieManagerFor(const std::string& partitionIdentifier) {
+    for (auto& pair : g_webview2Views) {
+        WebView2View* view = static_cast<WebView2View*>(pair.second);
+        if (!view || view->partition != partitionIdentifier) continue;
+        ComPtr<ICoreWebView2> webview = view->getWebView();
+        if (!webview) continue;
+
+        ComPtr<ICoreWebView2_2> webview2;
+        if (FAILED(webview->QueryInterface(IID_PPV_ARGS(&webview2)))) continue;
+
+        ComPtr<ICoreWebView2CookieManager> cookieManager;
+        if (SUCCEEDED(webview2->get_CookieManager(&cookieManager)) && cookieManager) {
+            return cookieManager;
+        }
+    }
+    return nullptr;
+}
